<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Each permission is explained inside the app (Settings -> Permissions). -->
    <!-- Show the "Game Booster" notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Draw the right-side gaming panel and touch-lock over your game. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Keep Gaming Mode alive while you play. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Screenshot / screen record: only after you accept Android's own capture prompt each time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Optional: detect when the game closes + show "last played". -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Optional: Do Not Disturb during games. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Memory boost: asks Android to end other apps' BACKGROUND processes (not force-stop). Normal permission. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Optional gaming extras: lower brightness / pause background sync while gaming (always restored). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!-- Network type + ping check (a tiny connection test to 1.1.1.1, only while panel/Performance is open). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: launcher apps only (used by "Add game"). No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.roblox.client" />
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="net.kdt.pojavlaunch" />
        <package android:name="net.kdt.pojavlaunch.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrostByte">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.FrostByte">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.GamingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Gaming mode: in-game side panel and device monitoring while the user plays a game" />
        </service>

        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.FrostByte.Transparent" />

        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Auto Clicker: can ONLY tap points you set. It does not request permission to read the screen. -->
        <service
            android:name=".service.ClickerService"
            android:exported="true"
            android:label="@string/clicker_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clicker_service_config" />
        </service>
    </application>
</manifest>
